# Copy this file to .env and fill in only what the adapters you use need.
# `make setup` copies it for you. .env is gitignored - never commit it.
#
# Everything here is OPTIONAL. `make demo` and `make test` run with this file
# completely blank, on mock adapters and the mock LLM provider.
#
# This agent does not use a PMS or a mailbox at all - see docs/integrations.md
# for why - so there is nothing to fill in for either here.

# --- How the agent thinks -------------------------------------------------
# Overrides llm.provider in config/hotel.yaml for one run.
# mock | interactive | claude-code | anthropic
LLM_PROVIDER=
LLM_MODEL=
LLM_EFFORT=

# Only for llm.provider: anthropic. Your own key, billed to you.
# The claude-code provider uses your Claude Code login instead and needs nothing here.
ANTHROPIC_API_KEY=

# On a server with no browser, Claude Code reads this instead of the keychain.
CLAUDE_CODE_OAUTH_TOKEN=

# shadow | live. Overrides `mode` in config/hotel.yaml. Leave blank to use the file.
AGENT_MODE=

# --- WhatsApp / chat (systems.messaging.adapter: unipile) -----------------
# Your own UniPile account, your own connected number. This is how "start
# this test" / "push this winner" reach a person.
UNIPILE_DSN=
UNIPILE_API_KEY=
UNIPILE_ACCOUNT_ID=
UNIPILE_STAFF_CHAT_ID=

# --- WhatsApp / chat (systems.messaging.adapter: webhook) -----------------
MESSAGING_WEBHOOK_URL=
MESSAGING_WEBHOOK_TOKEN=
MESSAGING_STAFF_WEBHOOK_URL=

# --- Google Sheets (systems.sheets.adapter: google) -----------------------
# Where every pushed winner gets logged, if you want a shared sheet instead
# of the default data/exports/experiment_decisions.csv.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=
